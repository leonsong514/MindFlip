{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindflip.local/contracts/health-error.schema.json",
  "title": "MindFlip IPC Error Envelope",
  "description": "Outer envelope for a failed response. The `code` field carries one of the stable error codes.",
  "type": "object",
  "required": ["protocol_version", "request_id", "ok", "error"],
  "properties": {
    "protocol_version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "const": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "backend_unavailable",
            "timeout",
            "invalid_protocol",
            "unknown_method"
          ]
        },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}