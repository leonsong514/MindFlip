# MindFlip local configuration template
#
# Copy this file to `.env` (which is gitignored) and fill in
# non-secret values. Real API keys must NEVER be stored here; they
# are reserved for the future OS credential bridge.
#
# Loading priority is fixed by the runtime: environment variables
# win over this file; the file wins over compiled-in defaults.

# Python interpreter used by the Tauri host. Required at runtime when
# running the desktop production build. Default: "python".
MINDFLIP_PYTHON=python

# Optional override for the application data directory. When unset,
# the runtime resolves %APPDATA%\MindFlip on Windows.
# MINDFLIP_DATA_DIR=C:\Users\you\AppData\Roaming\MindFlip

# Optional override for the Alembic URL (advanced; tests inject
# this). Do not point this at a production database by hand.
# MINDFLIP_DB_URL=sqlite:///C:/Users/you/AppData/Roaming/MindFlip/database/app.db